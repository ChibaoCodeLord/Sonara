# Cấu hình Server
PORT=5000
NODE_ENV=development

# Cấu hình Cơ sở dữ liệu MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/sonara_db

# Cấu hình Xác thực JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
AUTH_REFRESH_DAYS=30
# Số request API / IP trong 15 phút; stream và health được tách riêng.
API_RATE_LIMIT=100
# Chỉ cấu hình số hop khi thực sự chạy sau reverse proxy tin cậy.
TRUST_PROXY=false

# Cấu hình CORS
CORS_ORIGIN=*

# Cấu hình tài khoản Cloudinary
CLOUDINARY_CLOUD_NAME=hm8hhw5o
CLOUDINARY_API_KEY=438676921963891
CLOUDINARY_API_SECRET=XdVlD5EjLkLlaM5wvMVwFPgvDM0
CLOUDINARY_URL=cloudinary://438676921963891:XdVlD5EjLkLlaM5wvMVwFPgvDM0@hm8hhw5o

# Catalog Spotify: thông tin ứng dụng, không phải email/mật khẩu tài khoản.
# Tài khoản chủ ứng dụng Development Mode cần Premium theo quy định Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Có key: dùng YouTube Data API. Để trống: tìm metadata công khai bằng yt-dlp.
YOUTUBE_API_KEY=
# MusicBrainz yêu cầu User-Agent mô tả ứng dụng; thay URL bằng địa chỉ liên hệ của bạn.
MUSICBRAINZ_USER_AGENT=Sonara/1.0 (http://localhost:5173)

# Dịch vụ chuyển đổi MP3 cục bộ: npm run media (không cần MongoDB)
MEDIA_PORT=5001
# Dùng yt-dlp/ffmpeg trong PATH; có thể đặt đường dẫn tuyệt đối nếu cần.
# YTDLP_PATH=C:/tools/yt-dlp.exe
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# MEDIA_ORIGINS=http://localhost:5173,http://localhost:4173
